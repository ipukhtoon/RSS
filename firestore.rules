rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function storeDocPath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }
    function deviceDocPath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId)/devices/$(request.auth.token.rssDeviceId);
    }
    function hasActiveDevice(storeId) {
      return signedIn() &&
        request.auth.token.rssStoreId == storeId &&
        request.auth.token.rssDeviceId is string &&
        exists(deviceDocPath(storeId)) &&
        get(deviceDocPath(storeId)).data.authUid == request.auth.uid &&
        get(deviceDocPath(storeId)).data.status == 'active';
    }
    function employeeDocPath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId)/employees/$(get(deviceDocPath(storeId)).data.employeeId);
    }
    function activeMember(storeId) {
      return hasActiveDevice(storeId) &&
        exists(employeeDocPath(storeId)) &&
        get(employeeDocPath(storeId)).data.status == 'active';
    }
    function isOwner(storeId) {
      return activeMember(storeId) &&
        get(storeDocPath(storeId)).data.ownerUid == request.auth.uid &&
        get(employeeDocPath(storeId)).data.role == 'owner';
    }
    function employeeCanRead(storeId, permission) {
      let p = get(employeeDocPath(storeId)).data.permissions;
      return p[permission] == true ||
        (p.reports == true && permission in ['products','sales','expenses','purchases','returns']) ||
        (permission == 'products' && (p.dashboard == true || p.newSale == true || p.purchases == true || p.returns == true)) ||
        (permission == 'sales' && (p.dashboard == true || p.newSale == true || p.returns == true || p.udhaar == true)) ||
        (permission == 'returns' && (p.dashboard == true || p.sales == true));
    }
    function employeeCanWrite(storeId, permission) {
      let p = get(employeeDocPath(storeId)).data.permissions;
      return p[permission] == true ||
        (permission == 'products' && (p.newSale == true || p.purchases == true || p.returns == true)) ||
        (permission == 'sales' && p.newSale == true);
    }
    function canRead(storeId, permission) {
      return isOwner(storeId) || (activeMember(storeId) && employeeCanRead(storeId, permission));
    }
    function canWrite(storeId, permission) {
      return isOwner(storeId) || (activeMember(storeId) && employeeCanWrite(storeId, permission));
    }

    match /stores/{storeId} {
      allow read: if activeMember(storeId);
      // Store ownership is created/changed only by trusted Cloud Functions.
      allow create, update, delete: if false;

      match /employees/{employeeId} {
        allow read: if isOwner(storeId) ||
          (activeMember(storeId) &&
           get(deviceDocPath(storeId)).data.employeeId == employeeId);
        allow create, update, delete: if isOwner(storeId);
      }

      match /devices/{deviceId} {
        allow read: if isOwner(storeId) ||
          (hasActiveDevice(storeId) &&
           deviceId == request.auth.token.rssDeviceId);
        // Registration, approval and revocation are callable Functions only.
        allow create, update, delete: if false;
      }

      match /deviceInvites/{inviteId} {
        allow read, write: if false;
      }

      match /ronyal_pos/{rootDocId} {
        allow read: if activeMember(storeId);
        allow create: if isOwner(storeId) ||
          (rootDocId == 'root' && activeMember(storeId) &&
           request.resource.data.keys().hasOnly(['connectionTest']));
        allow update: if isOwner(storeId) ||
          (rootDocId == 'root' && activeMember(storeId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectionTest']));
        allow delete: if isOwner(storeId);

        match /{collectionName}/{recordId} {
          function permissionForCollection() {
            return collectionName == 'products' ? 'products' :
              collectionName == 'sales' ? 'sales' :
              collectionName == 'expenses' ? 'expenses' :
              collectionName == 'customers' ? 'udhaar' :
              collectionName == 'creditPayments' ? 'udhaar' :
              collectionName == 'suppliers' ? 'purchases' :
              collectionName == 'purchases' ? 'purchases' :
              collectionName == 'returns' ? 'returns' : '__deny__';
          }
          allow read: if permissionForCollection() != '__deny__' &&
            canRead(storeId, permissionForCollection());
          allow create, update, delete: if permissionForCollection() != '__deny__' &&
            canWrite(storeId, permissionForCollection());
        }

        match /_tombstones/{tombstoneId} {
          allow read: if activeMember(storeId);
          allow create, update: if activeMember(storeId) &&
            request.resource.data.store in ['products','sales','expenses','customers','suppliers','purchases','creditPayments','returns'] &&
            canWrite(storeId,
              request.resource.data.store == 'products' ? 'products' :
              request.resource.data.store == 'sales' ? 'sales' :
              request.resource.data.store == 'expenses' ? 'expenses' :
              request.resource.data.store == 'customers' || request.resource.data.store == 'creditPayments' ? 'udhaar' :
              request.resource.data.store == 'returns' ? 'returns' : 'purchases');
          allow delete: if isOwner(storeId);
        }
      }
    }
  }
}