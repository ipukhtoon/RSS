{
  "name": "ronyal-super-store",
  "version": "1.0.0",
  "private": true,
  "description": "Ronyal Super Store POS desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "build:windows": "npm run prepare:windows-icon && electron-builder --win nsis --publish never",
    "prepare:windows-icon": "node scripts/prepare-windows-icon.cjs"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.ronyal.superstore",
    "productName": "Ronyal Super Store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "manifest.json",
      "sw.js",
      "zxing-browser.min.js",
      "package.json",
      "ronyal-logo.png",
      "ronyal-logo-receipt.png",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  }
}
