{
"name": "ronyal-super-store",
"version": "1.0.0",
"private": true,
"description": "Ronyal Super Store POS desktop app",
"main": "electron/main.cjs",
"scripts": {
"build:windows": "electron-builder --win nsis"
},
"devDependencies": {
"electron": "^35.0.0",
"electron-builder": "^26.0.0"
},
"build": {
"appId": "com.ronyal.superstore",
"productName": "Ronyal Super Store",
"directories": {
"output": "dist"
},
"files": [
"electron/**/*",
"index.html",
"manifest.json",
"sw.js",
"package.json"
],
"win": {
"target": "nsis"
},
"nsis": {
"oneClick": false,
"allowToChangeInstallationDirectory": true
}
}
}
